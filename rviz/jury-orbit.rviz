Visualization Manager:
  Global Options:
    Fixed Frame: map
    Background Color: 30; 35; 43
  Displays:
    - Class: rviz_default_plugins/PointCloud2
      Name: Go2 map
      Enabled: true
      Topic:
        Value: /dogslam/map3d
      Color Transformer: FlatColor
      Color: 157; 180; 202
      Style: Points
      Size (Pixels): 2
    - Class: rviz_default_plugins/Path
      Name: Inspection
      Enabled: true
      Topic:
        Value: /dogslam/path
      Color: 255; 196; 50
      Line Style: Billboards
      Line Width: 0.20
    - Class: rviz_default_plugins/Pose
      Name: Robot
      Enabled: true
      Topic:
        Value: /dogslam/base_pose
      Color: 255; 100; 65
      Arrow Length: 1.1
      Head Radius: 0.30
      Shaft Radius: 0.12
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 19
      Pitch: 0.55
      Yaw: 0.8
      Focal Point:
        X: 1
        Y: 13
        Z: 0
      X: 1
      Y: 12
Window Geometry:
  Width: 1000
  Height: 650


